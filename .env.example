APP_ENV=development

# Admin login
ADMIN_USER=admin
ADMIN_PASS=change-me

# JWT cookie session auth for the admin panel.
# Required when APP_ENV=production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
COOKIE_NAME=admin_session
COOKIE_SECURE=0

# Cookie auth needs explicit frontend origins, not "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database / scraper settings
DATABASE_URL=postgresql://postgres:12345@localhost:5432/news_techorin
GEMINI_API_KEY=
