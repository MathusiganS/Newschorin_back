# Runtime
APP_NAME=Tamil News API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/news_techorin

# Admin and protected operational endpoints
ADMIN_USER=admin
ADMIN_PASS=change-me
# Preferred in production. When set, this takes precedence over ADMIN_PASS.
# Format: pbkdf2_sha256$iterations$base64_salt$base64_digest
ADMIN_PASSWORD_HASH=
# Recommended for run_all.py and other machine-to-machine operations.
SYNC_API_KEY=change-me-to-a-long-random-value

# Comma-separated origins. Use explicit HTTPS origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scraper scheduler
ENABLE_SCRAPE_SCHEDULER=1
SCRAPE_INTERVAL_SECONDS=900
SYNC_REQUEST_TIMEOUT_SECONDS=600
PLAYWRIGHT_INSTALL_ON_START=1
IMAGE_LOG_SAMPLE_LIMIT=25
API_SYNC_URL=http://127.0.0.1:4000/api/sync

# Classification
TAMILNEWS_MODEL_DIR=
TAMILNEWS_KEYWORD_FALLBACK=1

# Gemini paraphrasing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_TOP_P=0.8
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_MAX_ATTEMPTS=2
